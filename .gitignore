.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==========================================
# Data, Model Checkpoints & Experiment Logs
# Preserve data directory structure with .gitkeep while ignoring actual data
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

datasets/
checkpoints/
logs/
runs/
wandb/
results/
outputs/
*.log
*.pkl
*.pickle
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz

# ==========================================
