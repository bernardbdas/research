@startuml model_architectures
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam linetype ortho

skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #1D3557
    BorderThickness 1.2
    ArrowColor #1D3557
}

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #457B9D
    BorderThickness 1.2
    FontStyle bold
}

abstract class "flax.linen.Module" as Module <<Flax Core>> {
    + init(rngs, *args, **kwargs) : FrozenDict
    + apply(variables, *args, **kwargs) : Any
}

package "Residual & Multi-Scale Vision Backbones" {
    class "ResNet" as ResNet <<Flax Module>> {
        + stage_sizes : Sequence[int]
        + num_classes : int = 10
        + norm : str = "group"
        --
        + __call__(x : jnp.ndarray, train : bool) : jnp.ndarray
    }
    class "ResNet18" as ResNet18
    class "ResNet50" as ResNet50
    class "BasicBlock" as BasicBlock
    class "Bottleneck" as Bottleneck

    class "DenseNet169" as DenseNet169 <<Flax Module>>
    class "GoogLeNet" as GoogLeNet <<Flax Module>>
    class "InceptionV3" as InceptionV3 <<Flax Module>>
}

package "Classic & Efficient Convolutional Backbones" {
    class "SimpleCNN" as SimpleCNN <<Flax Module>>
    class "AlexNet" as AlexNet <<Flax Module>>
    class "VGG" as VGG <<Flax Module>> {
        + config : Sequence[int | str]
        + num_classes : int = 10
        + norm : str = "group"
        --
        + __call__(x : jnp.ndarray, train : bool) : jnp.ndarray
    }
    class "VGG16" as VGG16
    class "VGG19" as VGG19

    class "MobileNetV2" as MobileNetV2 <<Flax Module>>
    class "ShuffleNetV2" as ShuffleNetV2 <<Flax Module>>
}

package "Attention & Test-Time Adaptive Architectures" {
    class "VisionTransformer" as ViT <<Flax Module>> {
        + patch_size : int = 4
        + embed_dim : int = 192
        + depth : int = 9
        + num_heads : int = 3
    }

    class "VisionTTT" as VisionTTT <<Flax Module>> {
        + inner_lr : float = 0.05
        + depth : int = 2
        --
        + __call__(x : jnp.ndarray, test_time_update : bool) : jnp.ndarray
    }
    class "TTTLinearLayer" as TTTLayer {
        + dim : int
        + inner_lr : float
    }

    class "VisionTitans" as Titans <<Flax Module>> {
        + memory_dim : int
        + momentum : float
    }
}

package "Model Factory & Lifecycle Registry" {
    class "ModelRegistry" as ModelRegistry <<Factory>> {
        + MODEL_REGISTRY : dict[str, Type[Module]]
        --
        + get_model(name: str, num_classes: int, **kwargs) : Module
        + list_models() : list[str]
        + count_parameters(variables: dict) : int
    }
}

Module <|-- ResNet
Module <|-- SimpleCNN
Module <|-- AlexNet
Module <|-- VGG
Module <|-- MobileNetV2
Module <|-- ShuffleNetV2
Module <|-- DenseNet169
Module <|-- GoogLeNet
Module <|-- InceptionV3
Module <|-- ViT
Module <|-- VisionTTT
Module <|-- Titans

ResNet <|-- ResNet18
ResNet <|-- ResNet50
VGG <|-- VGG16
VGG <|-- VGG19

ResNet *-- BasicBlock
ResNet *-- Bottleneck
VisionTTT *-- TTTLayer

ModelRegistry ..> Module : instantiates all registered backbones

@enduml
