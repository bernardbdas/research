@startuml module2_cms
top to bottom direction

skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 14
skinparam ranksep 38
skinparam nodesep 28

' High-contrast publication styling for presentation slides
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #0F172A
    BorderThickness 2.5
    FontStyle bold
    FontSize 16
}

skinparam card {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.8
    FontSize 13
}

skinparam arrow {
    Color #0F172A
    Thickness 2.2
    FontSize 13
    FontStyle bold
}

' ============================================================================
' TOP TIER: INPUT REPRESENTATION & MULTI-HEAD PROJECTIONS
' ============================================================================
package "TIER 1: INPUT REPRESENTATION & ASSOCIATIVE PROJECTIONS" as Tier1 #F8FAFC {

    package "1. Streaming Feature Input" as SubIn #FFFFFF {
        card "<b>Feature Vector x<sub>t</sub> ∈ ℝ<sup>D</sup></b>\n• Extracted from CNN trunk\n• Input streaming test sample\n• Conditioned on local domain shift" as InputX #FFFFFF
    }

    package "2. Query, Key & Value Projections" as SubQKV #EFF6FF {
        card "<b>Subspace Linear Mappings</b>\n• Query Probe: <b>q</b><sub>t</sub> = <b>x</b><sub>t</sub> <b>W</b><sub>Q</sub> ∈ ℝ<sup>D<sub>k</sub></sup>\n• Associative Key: <b>k</b><sub>t</sub> = <b>x</b><sub>t</sub> <b>W</b><sub>K</sub> ∈ ℝ<sup>D<sub>k</sub></sup>\n• Informational Value: <b>v</b><sub>t</sub> = <b>x</b><sub>t</sub> <b>W</b><sub>V</sub> ∈ ℝ<sup>D<sub>v</sub></sup>" as QKV #FFFFFF
    }

    package "3. Continuous Memory Matrix State" as SubState #FFF7ED {
        card "<b>Prior Continuous Memory State M<sub>t-1</sub></b>\n• Persistent associative matrix: ℝ<sup>D<sub>k</sub> × D<sub>v</sub></sup>\n• Encodes accumulated test-time context\n• Retained locally on edge device" as PriorM #FFFFFF
    }

    SubIn -right-> SubQKV : Input Embedding <b>x</b><sub>t</sub>
    SubQKV -right-> SubState : Association Probe <b>k</b><sub>t</sub>
}

' ============================================================================
' BOTTOM TIER: SURPRISE ENGINE, FAST-WEIGHT WRITING & READOUT
' ============================================================================
package "TIER 2: ASSOCIATIVE SURPRISE & ONLINE FAST-WEIGHT WRITING" as Tier2 #F0FDF4 {

    package "4. Associative Surprise Detection" as SubSurprise #FFF7ED {
        card "<b>Retrieved Expectation:</b>  <b>v̂</b><sub>t</sub> = <b>k</b><sub>t</sub> <b>M</b><sub>t-1</sub>\n<i>(Memory's prediction of incoming value)</i>" as RetExp #FFFFFF

        card "<b>Associative Surprise Metric (Error)</b>\n<b>S</b><sub>t</sub> = <b>v</b><sub>t</sub> - <b>v̂</b><sub>t</sub>\n• Zero error → No memory overwrite\n• High error → Triggers rapid adaptation" as Surprise #FEF2F2

        RetExp -down-> Surprise
    }

    package "5. Forward-Pass Fast-Weight Writing" as SubUpdate #ECFDF5 {
        card "<b>Dynamic Forgetting Gate</b>\nα<sub>t</sub> = σ(<b>x</b><sub>t</sub> <b>W</b><sub>α</sub> + b<sub>α</sub>) ∈ (0, 1)\n<i>Input-dependent retention balance</i>" as Gate #EFF6FF

        card "<b>Hebbian Associative Memory Step</b>\nΔ<b>M</b><sub>t</sub> = η<sub>mem</sub> · (<b>k</b><sub>t</sub><sup>T</sup> ⊗ <b>S</b><sub>t</sub>)\n<b>M</b><sub>t</sub> = α<sub>t</sub> <b>M</b><sub>t-1</sub> + Δ<b>M</b><sub>t</sub>\n<b>[Updated in forward pass with 0 Backprop!]</b>" as UpdateM #FFFFFF

        Gate -down-> UpdateM
    }

    package "6. Readout & Residual Output" as SubReadout #FAF5FF {
        card "<b>Associative Readout</b>\n<b>r</b><sub>t</sub> = <b>q</b><sub>t</sub> <b>M</b><sub>t</sub>\n<i>Context-conditioned associative probe</i>" as Readout #FFFFFF

        card "<b>Residual Skip & Output Representation</b>\n<b>y</b><sub>t</sub> = LayerNorm(<b>r</b><sub>t</sub> <b>W</b><sub>O</sub> + <b>x</b><sub>t</sub>)\n• Memory-augmented representation\n• Ready for dynamic classification head" as OutputY #ECFDF5

        Readout -down-> OutputY
    }

    SubSurprise -right-> SubUpdate : Surprise Gradient <b>S</b><sub>t</sub>
    SubUpdate -right-> SubReadout : Updated State <b>M</b><sub>t</sub>
}

' ============================================================================
' INTER-TIER CONNECTIONS
' ============================================================================
SubQKV -down-> RetExp : Key Address <b>k</b><sub>t</sub>
SubQKV -down-> Surprise : Ground Truth <b>v</b><sub>t</sub>
SubState -down-> RetExp : Memory State <b>M</b><sub>t-1</sub>
SubIn -down-> Gate : Context Vector <b>x</b><sub>t</sub>
SubIn -down-> OutputY : Residual Skip Connection <b>x</b><sub>t</sub>
SubQKV -down-> Readout : Query Probe <b>q</b><sub>t</sub>

@enduml
