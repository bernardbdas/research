@startuml fl_system_overview
top to bottom direction

skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam ranksep 45
skinparam nodesep 28

' Palette: Professional Academic Slate & Deep Navy
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #1E293B
    BorderThickness 1.5
    FontStyle bold
    FontSize 12
}

skinparam card {
    BackgroundColor #F8FAFC
    BorderColor #475569
    BorderThickness 1.2
}

skinparam database {
    BackgroundColor #F1F5F9
    BorderColor #0F172A
    BorderThickness 1.2
}

skinparam cloud {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.3
}

skinparam arrow {
    Color #1E293B
    Thickness 1.3
}

' ========================================================
' TIER 1: CENTRAL SERVER COORDINATOR (Flower ServerApp)
' ========================================================
package "Tier 1: Central Server Coordinator (Flower ServerApp)" as Server {
    card "<b>Global Model Registry</b>\n* Canonical parameters <b>w</b><sub>t</sub>\n* Global evaluation & checkpointing" as S_Model #F8FAFC
    card "<b>Client Manager & Selector</b>\n* Samples active cohort S<sub>t</sub> ⊂ {1, ..., K}\n* Tracks client availability & latency" as S_Selector #F8FAFC
    card "<b>Federated Aggregator Strategy</b>\n* Federated averaging (FedAvg / FedMuon / FedProx)\n* <b>w</b><sub>t+1</sub> = <b>w</b><sub>t</sub> + Σ<sub>k</sub> (|D<sub>k</sub>| / |D|) · Δ<b>w</b><sub>t</sub><sup>k</sup>" as S_Agg #F8FAFC

    S_Model -right-> S_Selector : Weights <b>w</b><sub>t</sub>
    S_Selector -right-> S_Agg : Sampled cohort S<sub>t</sub>
}

' ========================================================
' TIER 2: SECURE TRANSPORT CHANNEL (gRPC / TLS)
' ========================================================
cloud "<b>Tier 2: Secure Transport Channel (gRPC / TLS)</b>\n<i>Model parameters only • Raw user data never leaves edge devices (Zero Data Leakage)</i>" as Transport

' ========================================================
' TIER 3: FEDERATED EDGE CLIENT (Flower ClientApp)
' ========================================================
package "Tier 3: Federated Edge Client k ∈ {1, ..., K} (Flower ClientApp)" as Client {
    database "<b>Private Local Dataset D<sub>k</sub></b>\n* Strictly on-device storage\n* No external access" as C_Data #F1F5F9
    card "<b>Local JAX/Flax Engine</b>\n* Forward loss & autodiff gradients\n* Optax state update (AdamW / SGD)" as C_Train #F8FAFC
    card "<b>Privacy & Sparsification</b>\n* DP-SGD (Clipping C + Noise σ)\n* Top-K sparsity + INT8 quantization" as C_Priv #F8FAFC
    card "<b>ClientApp Interface</b>\n* Ingests global weights <b>w</b><sub>t</sub>\n* Encodes parameter delta Δ<b>w</b><sub>t</sub><sup>k</sup>" as C_App #F8FAFC

    C_Data -right-> C_Train : Mini-batches
    C_Train -right-> C_Priv : Per-sample gradients
    C_Priv -right-> C_App : Processed delta Δ<b>w</b><sub>t</sub><sup>k</sup>
}

' ========================================================
' VERTICAL RANKING & INTER-TIER FLOW
' ========================================================
Server -[hidden]down-> Transport
Transport -[hidden]down-> Client

' Downlink flow (Server -> Network -> Client)
S_Selector -down-> Transport : <b>[Downlink]</b> Broadcast global weights <b>w</b><sub>t</sub>
Transport -down-> C_App : Receive <b>w</b><sub>t</sub>

' Uplink flow (Client -> Network -> Server)
C_App -up-> Transport : <b>[Uplink]</b> Transmit delta Δ<b>w</b><sub>t</sub><sup>k</sup>
Transport -up-> S_Agg : Deliver updates for aggregation

@enduml
