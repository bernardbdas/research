@startuml client_execution_lifecycle
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 4
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11

start

:Receive Server Invitation for Round $t$;

if (Selected by Server Sampling?) then (yes)
    :Download Global Weights $\mathbf{w}_t$;
    :Unpack NumPy weights into Flax parameter PyTree;
    :Initialize Local Optax Optimizer State;

    repeat :For each Local Epoch $e = 1, \dots, E$;
        repeat :For each Mini-batch $(X_b, Y_b) \subset \mathcal{D}_k$;
            :Compute Forward Pass & Classification Loss;

            if (Differential Privacy Enabled?) then (yes)
                :Compute per-sample gradients via **jax.vmap(jax.grad)**;
                :Clip gradient norms: $\bar{\mathbf{g}}_i = \mathbf{g}_i \cdot \min(1, \frac{C}{\|\mathbf{g}_i\|_2})$;
                :Sum and inject calibrated Gaussian noise: $\tilde{\mathbf{g}} = \frac{1}{B} \left( \sum \bar{\mathbf{g}}_i + \mathcal{N}(0, \sigma^2 C^2 \mathbf{I}) \right)$;
                :Update Privacy Accountant (accumulate spent $\epsilon, \delta$);
            else (no)
                :Compute standard batch gradient $\mathbf{g} = \nabla_{\mathbf{w}} \mathcal{L}$;
            endif

            :Apply updates to model weights via **Optax**;
        repeat while (More batches remaining in epoch?) is (yes)
        ->no;
    repeat while (More local epochs remaining?) is (yes)
    ->no;

    :Extract trained local weights $\mathbf{w}_{t+1}^k$;
    :Calculate parameter delta $\Delta \mathbf{w}_t^k = \mathbf{w}_{t+1}^k - \mathbf{w}_t$;

    if (Communication Compression Enabled?) then (yes)
        :Apply Top-$K$ Sparsification (drop bottom $|1-K|\%$ updates);
        :Apply INT8 Uniform Stochastic Quantization;
        :Encode into compressed bitstream;
    else (no)
        :Keep standard FP32 parameter arrays;
    endif

    :Transmit Update $\Delta \mathbf{w}_t^k$ and Sample Count $|\mathcal{D}_k|$ to Server;
else (no)
    :Remain in Idle / Power-Saving State;
endif

stop

@enduml
