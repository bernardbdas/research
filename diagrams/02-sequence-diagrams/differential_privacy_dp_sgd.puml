@startuml differential_privacy_dp_sgd
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 4
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #2B2D42
    BorderThickness 1.2
}

autonumber "<b>[00]</b>"

participant "DP Client Trainer\n(Local Worker)" as Trainer
participant "JAX Autodiff Engine\n(jax.vmap + jax.grad)" as JAX
participant "Clipping & Noise Kernel\n(DP Mechanism)" as DP
participant "Optax Optimizer\n(State Update)" as Optax
participant "Privacy Accountant\n(RDP / Moments)" as Accountant

== Per-Step Differential Privacy (DP-SGD) Execution ==

Trainer -> Trainer : Sample Poisson/Mini-batch B = {(x_1, y_1), ..., (x_B, y_B)}
Trainer -> JAX : Compute per-sample gradients in parallel:\ng_i = jax.vmap(jax.grad(loss_fn))(params, X_B, Y_B)
activate JAX
JAX --> Trainer : Tensor of per-sample gradients {g_1, ..., g_B}
deactivate JAX

== Gradient Norm Clipping ==
Trainer -> DP : Clip per-sample gradient norms to threshold C
activate DP
DP -> DP : Compute norm: ||g_i||_2 for each sample i
DP -> DP : Scale factor: s_i = min(1.0, C / ||g_i||_2)
DP -> DP : Clipped gradient: ḡ_i = g_i * s_i
DP --> Trainer : Clipped gradients {ḡ_1, ..., ḡ_B}
deactivate DP

== Noise Calibration & Addition ==
Trainer -> DP : Add calibrated Gaussian noise for (ε, δ) guarantee
activate DP
DP -> DP : Sum clipped gradients: G_sum = sum(ḡ_i)
DP -> DP : Sample Gaussian vector: η ~ N(0, σ² * C² * I)
DP -> DP : Perturbed gradient: G_private = (G_sum + η) / B
DP --> Trainer : Differentially private gradient G_private
deactivate DP

== Model State & Privacy Budget Update ==
Trainer -> Optax : updates, opt_state = optimizer.update(G_private, opt_state)
Trainer -> Optax : params = optax.apply_updates(params, updates)
Trainer -> Accountant : step(sample_rate=B/N, noise_multiplier=σ)
activate Accountant
Accountant -> Accountant : Accumulate Renyi DP divergence
Accountant --> Trainer : Current spent budget (ε, δ)
deactivate Accountant

@enduml
